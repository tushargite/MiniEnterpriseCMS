@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@{
    var hero = (ContentModels.Hero)Model.Content;
    var settings = Model.Settings as ContentModels.HeroSettings;

    // ButtonLink is a single Link (Multi URL Picker, max items = 1) — not a collection.
    var buttonLink = hero.ButtonLink;

    var sectionStyle = settings is null
        ? string.Empty
        : $"background-color:{settings.BackgroundColor};color:{settings.TextColor};padding-top:{settings.PaddingTop}px;padding-bottom:{settings.PaddingBottom}px;";
}
<section class="hero" style="@sectionStyle">
    <div class="hero__container">
        <div class="hero__content">
            @if (!string.IsNullOrWhiteSpace(hero.SubHeading))
            {
                <span class="hero__subheading">@hero.SubHeading</span>
            }
            @if (!string.IsNullOrWhiteSpace(hero.Heading))
            {
                <h1 class="hero__heading">@hero.Heading</h1>
            }
            @if (!string.IsNullOrWhiteSpace(hero.Description))
            {
                <p class="hero__description">@hero.Description</p>
            }
            @if (buttonLink is not null && !string.IsNullOrWhiteSpace(hero.ButtonText))
            {
                <a class="hero__button"
                   href="@buttonLink.Url"
                   target="@(string.IsNullOrWhiteSpace(buttonLink.Target) ? "_self" : buttonLink.Target)">
                    <span>@hero.ButtonText</span>
                </a>
            }
        </div>

        @if (hero.DesktopImage is not null)
        {
            <picture class="hero__media">
                @if (hero.MobileImage is not null)
                {
                    <source media="(max-width: 767px)" srcset="@hero.MobileImage.Url()" />
                }
                <img class="hero__image" src="@hero.DesktopImage.Url()" alt="@hero.Heading" />
            </picture>
        }
    </div>
</section>